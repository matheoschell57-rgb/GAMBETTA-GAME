rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'matheo.schell57@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function okName(n) { return n is string && n.size() > 0 && n.size() <= 20; }

    // Sauvegarde de chaque joueur, rangée sous son code secret
    match /players/{code} {
      allow get: if signedIn();
      allow list, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.pid is string
        && okName(request.resource.data.name);
      allow update: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.pid == resource.data.pid
        && okName(request.resource.data.name);
    }

    // Quel appareil a le droit d'écrire le score de quel joueur (lisible par l'admin seulement)
    match /owners/{pid} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/players/$(request.resource.data.code)).data.pid == pid;
    }

    // Classements : tout le monde lit, chacun n'écrit que sa ligne
    match /board/{pid} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (signedIn() && get(/databases/$(database)/documents/owners/$(pid)).data.uid == request.auth.uid);
    }

    // Cadeaux : seul l'admin envoie
    match /gifts/{id} {
      allow read: if isAdmin() || (signedIn() && id != 'log');
      allow write: if isAdmin();
    }

    // Échanges de cartes entre joueurs
    match /trades/{tid} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.st == 'wait'
        && request.resource.data.give is string && request.resource.data.want is string
        && get(/databases/$(database)/documents/owners/$(request.resource.data.from)).data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'done'])
        && (
          (resource.data.st == 'wait' && request.resource.data.st in ['yes', 'no']
            && get(/databases/$(database)/documents/owners/$(resource.data.to)).data.uid == request.auth.uid)
          || (resource.data.st == 'wait' && request.resource.data.st == 'cancel'
            && get(/databases/$(database)/documents/owners/$(resource.data.from)).data.uid == request.auth.uid)
          || (resource.data.st == 'yes' && request.resource.data.st == 'yes'
            && get(/databases/$(database)/documents/owners/$(resource.data.from)).data.uid == request.auth.uid)
        );
    }

    // Duels entre joueurs : chacun n'écrit que son côté
    match /duels/{id} {
      function own(p) { return get(/databases/$(database)/documents/owners/$(p)).data.uid == request.auth.uid; }
      allow read: if signedIn();
      allow delete: if isAdmin();
      // l'admin crée et arrête les matchs des tournois
      allow create, update: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.st == 'wait'
        && request.resource.data.k is string
        && request.resource.data.from != request.resource.data.to
        && own(request.resource.data.from);
      allow update: if signedIn() && (
        (own(resource.data.from)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['a', 'st'])
          && (request.resource.data.st == resource.data.st
              || (resource.data.st == 'wait' && request.resource.data.st == 'cancel')))
        || (own(resource.data.to)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['b', 'st', 'acc'])
          && (request.resource.data.st == resource.data.st
              || (resource.data.st == 'wait' && request.resource.data.st in ['on', 'no'])))
      );
    }

    // Tournois : l'admin gère tout, chaque joueur peut seulement s'inscrire ou se désinscrire
    match /tournaments/{tid} {
      function own(p) { return get(/databases/$(database)/documents/owners/$(p)).data.uid == request.auth.uid; }
      function joinOnly() {
        let ks = request.resource.data.players.diff(resource.data.players).affectedKeys();
        return ks.size() == 1 && own(ks.toList()[0]);
      }
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
      allow update: if signedIn()
        && resource.data.st == 'reg'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
        && joinOnly();
    }

    // Événements spéciaux : chaque joueur peut seulement s'inscrire et noter qu'il a joué, avant l'heure de fin
    match /events/{eid} {
      function own(p) { return get(/databases/$(database)/documents/owners/$(p)).data.uid == request.auth.uid; }
      function selfReg() {
        let ks = request.resource.data.players.diff(resource.data.players).affectedKeys();
        return ks.size() == 1 && own(ks.toList()[0]);
      }
      function selfPlayed() {
        let ks = request.resource.data.played.diff(resource.data.played).affectedKeys();
        return ks.size() == 1 && own(ks.toList()[0]);
      }
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
      allow update: if signedIn()
        && resource.data.st == 'open'
        && request.time.toMillis() < resource.data.endAt
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players']) && selfReg())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['played']) && selfPlayed()));
    }

    // Cartes bonus utilisées contre / pour un autre joueur (cadeau, voleur, supprimer, effacer)
    match /actions/{aid} {
      function own(p) { return get(/databases/$(database)/documents/owners/$(p)).data.uid == request.auth.uid; }
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.st == 'wait'
        && request.resource.data.type in ['cadeau', 'voleur', 'suppr', 'efface']
        && request.resource.data.from != request.resource.data.to
        && own(request.resource.data.from);
      // la cible applique la carte
      allow update: if signedIn() && resource.data.st == 'wait' && own(resource.data.to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'take']);
      // le voleur note qu'il a récupéré sa carte
      allow update: if signedIn() && own(resource.data.from)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['got']);
    }

    // Primes (carte bonus 🎯) : le premier qui bat la cible en duel dans les 4 h la remporte
    match /bounties/{bid} {
      function own(p) { return get(/databases/$(database)/documents/owners/$(p)).data.uid == request.auth.uid; }
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.st == 'open'
        && own(request.resource.data.by) && request.resource.data.on != request.resource.data.by;
      allow update: if signedIn() && resource.data.st == 'open'
        && request.time.toMillis() < resource.data.at + 4 * 3600 * 1000
        && request.resource.data.st == 'won'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'winner', 'winnerName'])
        && request.resource.data.winner != resource.data.on
        && own(request.resource.data.winner);
    }

    // Demandes des cartes « Photo à Mathéo » et « Mini-jeu à Mathéo »
    match /requests/{rid} {
      function own(p) { return get(/databases/$(database)/documents/owners/$(p)).data.uid == request.auth.uid; }
      allow create: if signedIn() && own(request.resource.data.from);
      allow read, update, delete: if isAdmin();
    }
  }
}
